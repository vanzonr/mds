HIGHLIGHT=pygments
ASPECTRATIO=169
FONTSIZE=10pt
FONTTHEME=structurebold
FONTFAMILY="Open Sans"
THEME=default # Antibes, Bergen, Boadilla, boxes, default, Goettingen, Hannover, Madrid, Marburg, Pittsburgh, Rochester
COLORTHEME=default
LOGO=$HERE/images/logo.png
LOGOHEIGHT=0.17
PLAINTITLE=true
INNERTHEME=rectangles
THEMETEX=$HERE/style.theme.tex
THEMETEX_TITLEIMAGE=$HERE/images/firstslide.png
THEMETEX_SECTIONIMAGE=$HERE/images/sectionslide.png
THEMETEX_BACKGROUNDCOLOR=0.9,0.9,0.9
THEMETEX_FOREGROUNDCOLOR=0.0,0.0,0.0
