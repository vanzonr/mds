# %HEADERTXT
## This file contains the settings for the theme %THEME

# %ASPECTRATIOTXT
ASPECTRATIO=169

# %FONTSIZETXT
FONTSIZE=10pt

# %THEMETXT
THEME=Boadilla

# %INNERTHEMETXT
INNERTHEME=rounded

# %FONTTHEMETXT
FONTTHEME=structurebold

# %COLORTHEMETXT
COLORTHEME=orchid

if [ $HANDOUT = true ]
then
    # %THEMETEXTXT
    THEMETEX=$HERE/style_handout.tex
