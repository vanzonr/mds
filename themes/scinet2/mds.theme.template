    LOGOUP=-0.03
else
    # %THEMETEXTXT
    THEMETEX=$HERE/style.tex
    # %HIGHLIGHTTXT
    HIGHLIGHT=zenburn
    # %LOGOTXT
    LOGO=$HERE/scinetlogodark.png
